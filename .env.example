# Copy to .env (untracked) and fill in. Bun loads .env automatically.
KLEIS_URL=https://kleis.example.com
KLEIS_TOKEN=the kleis ADMIN_TOKEN
# IDs of the accounts to show, comma separated. Accounts not listed, including new ones, are hidden.
KLEIS_ACCOUNTS=
# Names to show instead of kleis labels, label=name, comma separated. The screen fits 6 characters.
KLEIS_NAMES=
KLEIS_INTERVAL_MINUTES=5
